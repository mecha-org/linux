&lpi2c4 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c4>;
	status = "okay";

	max98090: max98090@10 {
		#sound-dai-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_sai3>;
		pinctrl-1 = <&pinctrl_codec>;
		compatible = "maxim,max98091";
		reg = <0x10>;
		clocks = <&scmi_clk IMX95_CLK_SAI3>;
		interrupt-parent = <&gpio2>;
		interrupts = <18 IRQ_TYPE_LEVEL_LOW>;
		clock-names = "mclk";
		status = "okay";
	};

	bq27441: fuel-gauge@55 {
		compatible = "ti,bq27441";
		reg = <0x55>;
		status = "okay";
		monitored-battery = <&bat>;
		bat: battery {
			compatible = "simple-battery";
			over-voltage-threshold-microvolt = <4500000>;
			re-charge-voltage-microvolt = <250000>;
			voltage-min-design-microvolt = <3200000>;
			voltage-max-design-microvolt = <4200000>;
			energy-full-design-microwatt-hours = <5290000>;
			charge-full-design-microamp-hours = <1430000>;
			precharge-current-microamp = <256000>;
			precharge-upper-limit-microvolt = <2500000>;
			charge-term-current-microamp = <128000>;
			constant-charge-current-max-microamp = <900000>;
			constant-charge-voltage-max-microvolt = <4200000>;
			factory-internal-resistance-micro-ohms = <250000>;
			ocv-capacity-celsius = <(-10) 0 10>;
			/* table for -10 degree Celsius */
			ocv-capacity-table-0 = <4185000 100>, <4113000 95>, <4066000 90>;
			/* table for 0 degree Celsius */
			ocv-capacity-table-1 = <4200000 100>, <4185000 95>, <4113000 90>;
			/* table for 10 degree Celsius */
			ocv-capacity-table-2 = <4250000 100>, <4200000 95>, <4185000 90>;
			resistance-temp-table = <20 100>, <10 90>, <0 80>, <(-10) 60>;
			operating-range-celsius = <(-30) 50>;
			ambient-celsius = <(-5) 50>;
			alert-celsius = <0 40>;
		};
	};
};

&lpi2c5 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c5>;
	status = "okay";

	ads1015@48 {
		compatible = "ti,ads1015";
		reg = <0x48>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&lpi2c6 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpi2c6>;
	status = "okay";

	pcal6408_b: gpio@20 {
		compatible = "nxp,pcal6408";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;

		#interrupt-cells = <2>;
		interrupt-controller;
		interrupt-parent = <&gpio5>;
		interrupts = <14 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pcal6524>;


		gpio-line-names =
		"WIFI_RST_IND_3V3",
		"WIFI_SD_INT_3V3",
		"WIFI_RST_3V3",
		"BT/15.4_RST_3V3",
		"WIFI_WL_DEV_WAKE_3V3",
		"BT/15.4_DEV_WAKE_3V3",
		"IO_CONN_LOAD_SW_EN",
		"INT_ALS_3V3";

		io_conn_load_sw_en {
			gpio-hog;
			gpios = <6 GPIO_ACTIVE_LOW>;
			output-low;
			line-name = "IO_CONN_LOAD_SW_EN";
		};

		wifi_rst_3v3 {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "WIFI_RST_3V3";
		};

		bt_rst_3v3 {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "BT/15.4_RST_3V3";
		};

	};

	tca9535_a: gpio@23 {
		compatible = "ti,tca9535";
		reg = <0x23>;
		gpio-controller;
		#gpio-cells = <2>;

		#interrupt-cells = <2>;
		interrupt-controller;
		interrupt-parent = <&gpio2>;
		interrupts = <21 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pcal6524>;

		gpio-line-names =
		"USB1_3.0_MUX_SEL",
		"INT2/FSYNC",
		"USB1_ID_CC",
		"USBHUB_RESET#",
		"HWREV_1",
		"HWREV_0",
		"DP_1.2_IRQ",
		"USB2_PWR_FAULT",
		"USB1_PWR_EN_uP",
		"USB1_PWR_FAULT",
		"USBHUB_CHIPEN",
		"NC_13",
		"NC_14",
		"nSLEEP_HAPTIC",
		"ADC_ALERT/RDY_3V3",
		"MAGNETOMETER_INT";

		usb_hub_rst {
			gpio-hog;
			gpios = <3 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "USB_HUB_RST";
		};

		usb_hub_en {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_HIGH>;
			output-low;
			line-name = "USB_HUB_EN";
		};
	};

	tca9535_b: gpio@26 {
		compatible = "ti,tca9535";
		reg = <0x26>;
		gpio-controller;
		#gpio-cells = <2>;

		#interrupt-cells = <2>;
		interrupt-controller;
		interrupt-parent = <&gpio2>;
		interrupts = <22 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pcal6524>;

		gpio-line-names =
		"RESET_PCIE#_3V3",
		"W_DISABLE2#_3V3",
		"RST_DP1.2",
		"RTC_INT",
		"FG_GPOUT_3V3",
		"PCIE_RST#_3V3",
		"PCIE_WAKE#_3V3",
		"DEVSLP_3V3",
		"CONFIG_0",
		"DPR_PCIE_3V3",
		"PCIE_GPIO9_1V8",
		"W_DISABLE1#_3V3",
		"FULL_CARD_PWROFF_PCIE",
		"CONFIG_3",
		"CONFIG_1",
		"CONFIG_2";

		rst_dpi {
			gpio-hog;
			gpios = <2 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "RST_DP1.2";
		};

		pcie_gpio {
			gpio-hog;
			gpios = <10 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "PCIE_GPIO9_1V8";
		};
	};
};

&lpspi3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lpspi3>;
	cs-gpios = <&gpio2 8 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev0: spi@0 {
		reg = <0>;
		compatible = "lwn,bk4";
		spi-max-frequency = <1000000>;
	};
};

&lpuart1 {
	/* console */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&lpuart3 {
	/* bluetooth */
	uart-has-rtscts;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	status = "okay";

	bluetooth {
		compatible = "nxp,88w8987-bt";
		reset-gpios = <&pcal6408_b 3 GPIO_ACTIVE_LOW>;
		fw-init-baudrate = <3000000>;
		status = "okay";
	};
};

&lpuart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>;
	status = "okay";
};

&mu7 {
	status = "okay";
};

&usdhc1 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc1>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>;
	pinctrl-3 = <&pinctrl_usdhc1>;
	bus-width = <8>;
	fsl,tuning-step = <1>;
	non-removable;
	no-sdio;
	no-sd;
	status = "okay";
};

&usdhc2 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>, <&pinctrl_usdhc2_gpio>;
	pinctrl-3 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	cd-gpios = <&gpio3 00 GPIO_ACTIVE_LOW>;
	fsl,cd-gpio-wakeup-disable;
	vmmc-supply = <&reg_usdhc2_vmmc>;
	bus-width = <4>;
	fsl,tuning-step = <1>;
	status = "okay";
};

&usdhc3 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
	pinctrl-0 = <&pinctrl_usdhc3>;
	pinctrl-1 = <&pinctrl_usdhc3_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc3_200mhz>;
	pinctrl-3 = <&pinctrl_usdhc3>;
	mmc-pwrseq = <&wifi_pwrseq>;

	bus-width = <4>;
	keep-power-in-suspend;
	non-removable;
	wakeup-source;
	cap-sdio-irq;
	status = "okay";
};

