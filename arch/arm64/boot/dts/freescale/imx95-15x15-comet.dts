&usb3 {
	status = "disabled";
};

&scmi_misc {
	nxp,ctrl-ids = <BRD_SM_CTRL_SD3_WAKE		1
			BRD_SM_CTRL_PCIE1_WAKE		1
			BRD_SM_CTRL_BT_WAKE		1
			BRD_SM_CTRL_PCIE2_WAKE		1
			BRD_SM_CTRL_BUTTON		1>;
};

